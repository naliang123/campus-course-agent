# 数据库
DATABASE_URL=mysql+pymysql://root:password@127.0.0.1:3306/campus_course_agent
# JWT
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_EXPIRE_HOURS=24
JWT_ALGORITHM=HS256

# 独立 FastMCP 服务
MCP_HOST=127.0.0.1
MCP_PORT=8001
MCP_PATH=/mcp

# 对话模型（OpenAI 兼容接口，默认 DeepSeek）
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=替换为你的DeepSeekAPI-Key
LLM_MODEL_NAME=deepseek-flash
AGENT_RECURSION_LIMIT=14

# 向量模型与对话模型分开配置
EMBEDDING_API_KEY=替换为你的向量模型密钥
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3
CHROMA_COLLECTION=course_docs
CHROMA_HOST=127.0.0.1
CHROMA_PORT=8002
